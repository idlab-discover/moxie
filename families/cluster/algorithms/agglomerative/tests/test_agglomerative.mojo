import numojo as nm
from std.testing import assert_equal, assert_true, assert_false, assert_raises
from moxie.base import clone, UnsupervisedEstimator, FitTransformer
from moxie.cluster import AgglomerativeClustering, FeatureAgglomeration, ward_tree, linkage_tree, Clusterer
from moxie.cluster._agglomerative import FullTree


def dispatch[T: UnsupervisedEstimator](mut model: T, x: T.Input, y: Optional[T.Target]) raises:
    var params = model.get_params()
    _ = model.set_params(params).fit(x, y)


def transform_dispatch[T: FitTransformer](mut model: T, x: T.Input, y: Optional[T.Target]) raises -> T.Transformed:
    return model.fit_transform(x, y)


def check[dtype: DType]() raises:
    var x = nm.zeros[dtype](nm.Shape(5, 2))
    for i in range(5):
        x[nm.Item(i, 0)] = SIMD[dtype, 1](i*i)
        x[nm.Item(i, 1)] = SIMD[dtype, 1](2*i)
    var model = AgglomerativeClustering[dtype](compute_full_tree="auto")
    assert_equal(model.params.n_clusters.value(), 2)
    assert_equal(model.params.metric, "euclidean")
    assert_equal(model.params.linkage, "ward")
    assert_equal(model.params.compute_full_tree.mode, 2)
    assert_false(Bool(model.params.connectivity))
    assert_false(Bool(model.params.memory))
    assert_false(Bool(model.params.distance_threshold))
    assert_false(model.params.compute_distances)
    assert_false(model.__sklearn_is_fitted__())
    dispatch(model, x, Optional[nm.NDArray[dtype]](None))
    assert_true(model.__sklearn_is_fitted__())
    assert_equal(model.children_.shape[0], 4)
    assert_equal(model.children_.shape[1], 2)
    assert_equal(model.n_leaves_, 5)
    assert_equal(model.n_clusters_, 2)
    assert_equal(model.n_connected_components_, 1)
    assert_equal(model.n_features_in_, 2)
    assert_false(Bool(model.distances_))
    var original = model.labels_.copy()
    var labels = model.fit_predict(x, x.copy())
    for i in range(5): assert_equal(labels.item(i), original.item(i))
    labels.unsafe_set(0, 99)
    assert_equal(model.labels_.item(0), original.item(0))
    var fresh = clone(model)
    assert_false(fresh.__sklearn_is_fitted__())
    assert_equal(fresh.children_.size, 0)
    var copied = model.copy()
    copied.labels_.unsafe_set(0, 99)
    assert_equal(model.labels_.item(0), original.item(0))
    _ = model.set_params(n_clusters=Optional[Int](1), compute_distances=True, compute_full_tree=FullTree(False)).fit(x)
    assert_equal(model.n_clusters_, 1)
    assert_equal(model.distances_.value().size, 4)
    _ = model.set_params(n_clusters=Optional[Int](None), distance_threshold=Optional[Float64](0), compute_full_tree=FullTree("auto")).fit(x)
    assert_equal(model.n_clusters_, 5)
    _ = model.set_params(n_clusters=Optional[Int](2), distance_threshold=Optional[Float64](None), compute_distances=False).fit(x)
    assert_false(Bool(model.distances_))
    var tree = ward_tree(x)
    tree.validate()
    assert_false(Bool(tree.distances))
    assert_false(Bool(tree.parents))
    for i in range(4):
        for j in range(2): assert_equal(tree.children.item(i, j), model.children_.item(i, j))
    var reverse = x.view_with_layout(nm.Shape(5,2), nm.Strides(-2,1), 8)
    var packed = nm.zeros[dtype](nm.Shape(5,2))
    for i in range(5):
        for j in range(2): packed[nm.Item(i,j)] = reverse.item(i,j)
    for method in ["single", "complete", "average"]:
        var a = linkage_tree(reverse, linkage=method)
        var b = linkage_tree(packed, linkage=method)
        for i in range(4):
            for j in range(2): assert_equal(a.children.item(i,j), b.children.item(i,j))
    var reversed_ward = ward_tree(reverse)
    var packed_ward = ward_tree(packed)
    for i in range(4):
        for j in range(2): assert_equal(reversed_ward.children.item(i,j), packed_ward.children.item(i,j))
    var features = FeatureAgglomeration[dtype](1, compute_full_tree=True)
    assert_equal(features.params.pooling_func, "mean")
    with assert_raises(): _ = features.transform(x)
    with assert_raises(): _ = features.inverse_transform(x)
    with assert_raises(): _ = features.get_feature_names_out()
    var strided_features = FeatureAgglomeration[dtype](1)
    var strided_output = strided_features.fit_transform(reverse)
    var packed_features = FeatureAgglomeration[dtype](1)
    var packed_output = packed_features.fit_transform(packed)
    for i in range(5): assert_equal(strided_output.item(i,0), packed_output.item(i,0))
    var output = transform_dispatch(features, x, Optional[nm.NDArray[dtype]](None))
    assert_equal(output.shape[0], 5)
    assert_equal(output.shape[1], 1)
    assert_equal(features.n_leaves_, 2)
    for i in range(5): assert_equal(output.item(i,0), Float64(i*i+2*i)/2)
    var restored = features.inverse_transform(output)
    for i in range(5):
        for j in range(2): assert_equal(restored.item(i,j), output.item(i,0))
    var values = nm.full[dtype](nm.Shape(1), 7)
    var vector = features.inverse_transform(values)
    assert_equal(vector.ndim, 1)
    assert_equal(vector.shape[0], 2)
    assert_equal(vector.item(1), SIMD[dtype,1](7))
    var names = features.get_feature_names_out()
    assert_equal(names[0], "featureagglomeration0")
    var custom_names: List[String] = ["a", "b"]
    _ = features.get_feature_names_out(custom_names.copy())
    var bad_names: List[String] = ["a"]
    with assert_raises(): _ = features.get_feature_names_out(bad_names.copy())
    var fresh_features = clone(features)
    assert_false(fresh_features.__sklearn_is_fitted__())
    dispatch(features, x, Optional[nm.NDArray[dtype]](None))
    _ = features.set_params(n_clusters=Optional[Int](2), linkage="single", compute_distances=True).fit(x)
    assert_equal(features.n_clusters_, 2)
    assert_equal(features.distances_.value().size, 1)
    var params = features.get_params()
    params.connectivity = x.copy()
    _ = features.set_params(params)
    params.connectivity.value()[nm.Item(0,0)] = 99
    assert_equal(features.params.connectivity.value().item(0,0), SIMD[dtype,1](0))
    with assert_raises(): _ = features.fit(x)
    _ = features.set_params(connectivity=Optional[nm.NDArray[dtype]](None), pooling_func="median")
    with assert_raises(): _ = features.fit(x)
    _ = features.set_params(pooling_func="mean", memory=Optional[String]("cache"))
    with assert_raises(): _ = features.fit(x)
    _ = features.set_params(memory=Optional[String](None))
    var empty = nm.zeros[dtype](nm.Shape(0,2))
    var singleton = nm.zeros[dtype](nm.Shape(1,2))
    var one_feature = nm.zeros[dtype](nm.Shape(4,1))
    var rank_one = nm.zeros[dtype](nm.Shape(4))
    with assert_raises(): _ = model.fit(empty)
    with assert_raises(): _ = model.fit(singleton)
    with assert_raises(): _ = model.fit(rank_one)
    with assert_raises(): _ = features.fit(one_feature)
    with assert_raises(): _ = features.transform(one_feature)
    with assert_raises(): _ = features.inverse_transform(values)
    var nonfinite = x.copy()
    nonfinite[nm.Item(0,0)] = SIMD[dtype,1](Float64("nan"))
    with assert_raises(): _ = model.fit(nonfinite)
    with assert_raises(): _ = features.fit(nonfinite)
    nonfinite[nm.Item(0,0)] = SIMD[dtype,1](Float64("inf"))
    with assert_raises(): _ = ward_tree(nonfinite)
    with assert_raises(): _ = linkage_tree(x, linkage="ward")
    with assert_raises(): _ = linkage_tree(x, linkage="bad")
    with assert_raises(): _ = linkage_tree(x, affinity="precomputed")
    with assert_raises(): _ = linkage_tree(x, affinity="cosine")
    with assert_raises(): _ = ward_tree(x, connectivity=x.copy())
    with assert_raises(): _ = ward_tree(x, n_clusters=0)
    with assert_raises(): _ = ward_tree(x, n_clusters=-1)
    assert_equal(ward_tree(x, n_clusters=1).children.shape[0], x.shape[0] - 1)
    # linkage_tree has no parameter validation in sklearn; n_clusters=0 is ignored there.
    assert_equal(linkage_tree(x, n_clusters=0).children.shape[0], x.shape[0] - 1)
    with assert_raises(): _ = linkage_tree(x, connectivity=x.copy())
    _ = model.set_params(metric="manhattan")
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(metric="euclidean", n_clusters=Optional[Int](6))
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(n_clusters=Optional[Int](0))
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(n_clusters=Optional[Int](None))
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(n_clusters=Optional[Int](2), distance_threshold=Optional[Float64](1))
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(n_clusters=Optional[Int](None), distance_threshold=Optional[Float64](-1))
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(distance_threshold=Optional[Float64](Float64("nan")))
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(distance_threshold=Optional[Float64](1), compute_full_tree=FullTree(False))
    with assert_raises(): _ = model.fit(x)
    with assert_raises(): _ = FullTree("bad")
    # A failed refit does not replace the last successful learned tree.
    assert_equal(model.n_clusters_, 2)
    for i in range(5): assert_equal(model.labels_.item(i), original.item(i))
    _ = features.fit(singleton)
    assert_equal(features.n_features_in_, 2)
    var wider = nm.zeros[dtype](nm.Shape(1,3))
    _ = features.fit(wider)
    assert_equal(features.n_features_in_, 3)
    assert_equal(features.labels_.size, 3)


def main() raises:
    check[DType.float32]()
    check[DType.float64]()
    var cosine_overflow = nm.full[DType.float64](nm.Shape(2,2), 1e200)
    with assert_raises(): _ = linkage_tree(cosine_overflow, affinity="cosine")
    var cosine_underflow = nm.full[DType.float64](nm.Shape(2,2), 1e-200)
    with assert_raises(): _ = linkage_tree(cosine_underflow, affinity="cosine")
    var extreme = nm.zeros[DType.float64](nm.Shape(2,2))
    extreme[nm.Item(0,1)] = Float64("1.7976931348623157e308")
    for method in ["single", "complete", "average"]:
        var tree = linkage_tree(extreme, affinity="precomputed", linkage=method, return_distance=True)
        assert_equal(tree.distances.value().item(0), Float64("1.7976931348623157e308"))
    print("PASS: agglomerative contracts, lifecycle, layouts, pooling and errors")
