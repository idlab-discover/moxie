import numojo as nm
from std.testing import assert_equal, assert_true, assert_raises
from moxie import clone
from moxie.cluster import MiniBatchKMeans
from moxie.cluster._kmeans import KMeansInit, KMeansNInit
from std.utils.numerics import inf
from moxie._random import RandomState, seed_global_random_state, check_random_state


def exercise[dtype: DType]() raises:
    var x = nm.zeros[dtype](nm.Shape(4, 1))
    x.unsafe_set(1, 2)
    x.unsafe_set(2, 10)
    x.unsafe_set(3, 12)
    var centers = nm.zeros[dtype](nm.Shape(2, 1))
    centers.unsafe_set(1, 10)
    var weights = nm.ones[dtype](nm.Shape(4))
    weights.unsafe_set(1, 3)
    var model = MiniBatchKMeans[dtype](2, init=KMeansInit[dtype](centers), random_state=42, reassignment_ratio=0)
    with assert_raises(): _ = model.predict(x)
    _ = model.partial_fit(x, sample_weight=weights.view())
    assert_equal(model.n_steps_, 1)
    assert_true(not model.n_iter_)
    assert_equal(model._counts.item(0), 4)
    assert_equal(model._counts.item(1), 2)
    assert_equal(model.cluster_centers_.item(0, 0), 1.5)
    assert_equal(model.cluster_centers_.item(1, 0), 11)
    var first = model.cluster_centers_.copy()
    _ = model.partial_fit(x, sample_weight=weights.view())
    assert_equal(model.n_steps_, 2)
    assert_equal(model._counts.item(0), 8)
    assert_equal(model.cluster_centers_.item(0, 0), first.item(0, 0))
    var copied = clone(model)
    assert_true(not copied.__sklearn_is_fitted__())
    copied.params.init.centers.value().unsafe_set(0, 99)
    assert_equal(model.params.init.centers.value().item(0, 0), 0)
    var small = nm.ones[dtype](nm.Shape(1, 1))
    _ = model.partial_fit(small)
    assert_equal(model.labels_.size, 1)
    assert_equal(model.n_steps_, 3)
    var invalid = nm.ones[dtype](nm.Shape(2, 2))
    with assert_raises(): _ = model.partial_fit(invalid)
    with assert_raises(): _ = model.predict(invalid)
    var before = model.cluster_centers_.copy()
    x.unsafe_set(0, 100)
    assert_equal(model.cluster_centers_.item(0, 0), before.item(0, 0))
    x.unsafe_set(0, 0)
    _ = model.fit(x)
    var fitted = model.cluster_centers_.copy()
    var steps = model.n_steps_
    _ = model.fit(x)
    assert_equal(model.n_steps_, steps)
    for i in range(fitted.size): assert_equal(model.cluster_centers_.item(i), fitted.item(i))
    assert_true(model.n_iter_)
    _ = model.partial_fit(x)
    assert_equal(model.n_steps_, steps + 1)
    var labels = model.predict(x)
    var distance = model.transform(x)
    assert_equal(labels.size, 4)
    assert_equal(distance.shape[0], 4)
    assert_equal(distance.shape[1], 2)
    assert_true(model.score(x) <= 0)
    var disabled = MiniBatchKMeans[dtype](2, compute_labels=False, random_state=0)
    _ = disabled.partial_fit(x)
    assert_equal(disabled.labels_.size, 0)
    assert_true(not disabled.inertia_)
    _ = disabled.fit(x)
    assert_true(disabled.inertia_)
    assert_equal(disabled.labels_.size, 0)
    _ = disabled.set_params(compute_labels=True)
    _ = disabled.partial_fit(x)
    assert_equal(disabled.labels_.size, 4)
    var bad = MiniBatchKMeans[dtype](5)
    with assert_raises(): _ = bad.partial_fit(x)
    _ = bad.set_params(n_clusters=2, batch_size=0)
    with assert_raises(): _ = bad.fit(x)
    _ = bad.set_params(batch_size=2, reassignment_ratio=Float64(-1))
    with assert_raises(): _ = bad.fit(x)
    _ = bad.set_params(reassignment_ratio=Float64(0), init=KMeansInit[dtype]("callable"))
    with assert_raises(): _ = bad.fit(x)
    var rng = RandomState(42)
    var stream = MiniBatchKMeans[dtype](2)
    _ = stream.partial_fit(x, random_state=rng)
    _ = stream.partial_fit(x, random_state=rng)
    var internal = MiniBatchKMeans[dtype](2, random_state=42)
    _ = internal.partial_fit(x)
    _ = internal.partial_fit(x)
    for i in range(stream.cluster_centers_.size): assert_equal(stream.cluster_centers_.item(i), internal.cluster_centers_.item(i))
    assert_equal(rng._pos, internal._random_state.value()._pos)
    seed_global_random_state(42)
    var global_model = MiniBatchKMeans[dtype](2)
    _ = global_model.fit(x)
    var seeded = MiniBatchKMeans[dtype](2, random_state=42)
    _ = seeded.fit(x)
    for i in range(seeded.cluster_centers_.size): assert_equal(seeded.cluster_centers_.item(i), global_model.cluster_centers_.item(i))
    seed_global_random_state(42)
    var global_partial = MiniBatchKMeans[dtype](2)
    var borrowed_partial = MiniBatchKMeans[dtype](2)
    var borrowed_rng = RandomState(42)
    _ = global_partial.partial_fit(x)
    _ = borrowed_partial.partial_fit(x, random_state=borrowed_rng)
    with check_random_state(None) as global_rng:
        assert_equal(global_rng[].next_uint32(), borrowed_rng.next_uint32())
    _ = global_partial.partial_fit(x)
    _ = borrowed_partial.partial_fit(x, random_state=borrowed_rng)
    for i in range(global_partial.cluster_centers_.size): assert_equal(global_partial.cluster_centers_.item(i), borrowed_partial.cluster_centers_.item(i))
    assert_equal(global_partial._random_state.value()._pos, borrowed_rng._pos)
    _ = borrowed_rng.standard_normal()
    var gaussian_cache = borrowed_rng._gauss
    var has_gaussian = borrowed_rng._has_gauss
    _ = borrowed_partial.partial_fit(x, random_state=borrowed_rng)
    assert_equal(borrowed_rng._gauss, gaussian_cache)
    assert_equal(borrowed_rng._has_gauss, has_gaussian)
    var reversed_x = x.view_with_layout(nm.Shape(4, 1), nm.NDArrayStrides(-1, 1), 3)
    var contiguous = nm.zeros[dtype](nm.Shape(4, 1))
    for i in range(4): contiguous.unsafe_set(i, reversed_x.item(i, 0))
    var strided = MiniBatchKMeans[dtype](2, random_state=7)
    var dense = MiniBatchKMeans[dtype](2, random_state=7)
    _ = strided.partial_fit(reversed_x)
    _ = dense.partial_fit(contiguous)
    for i in range(dense.cluster_centers_.size): assert_equal(strided.cluster_centers_.item(i), dense.cluster_centers_.item(i))
    var zeros = nm.zeros[dtype](nm.Shape(4))
    var retained = model.cluster_centers_.copy()
    _ = model.set_params(reassignment_ratio=Float64(0))
    _ = model.partial_fit(x, sample_weight=zeros.view())
    for i in range(retained.size): assert_equal(model.cluster_centers_.item(i), retained.item(i))
    with assert_raises(): _ = model.fit(x, sample_weight=zeros.view())
    var short_weights = nm.ones[dtype](nm.Shape(3))
    with assert_raises(): _ = model.partial_fit(x, sample_weight=short_weights.view())
    var empty = nm.zeros[dtype](nm.Shape(0, 1))
    with assert_raises(): _ = model.partial_fit(empty)
    with assert_raises(): _ = model.partial_fit(weights)
    var nonfinite = x.copy()
    nonfinite.unsafe_set(0, inf[dtype]())
    with assert_raises(): _ = model.fit(nonfinite)
    with assert_raises(): _ = model.partial_fit(nonfinite)
    with assert_raises(): _ = model.transform(nonfinite)
    var parameters = model.get_params()
    parameters.n_init = KMeansNInit(0)
    _ = model.set_params(parameters)
    with assert_raises(): _ = model.fit(x)
    parameters.n_init = KMeansNInit(1)
    parameters.max_no_improvement = -1
    _ = model.set_params(parameters)
    with assert_raises(): _ = model.fit(x)
    parameters.max_no_improvement = None
    parameters.init_size = 0
    _ = model.set_params(parameters)
    with assert_raises(): _ = model.fit(x)
    parameters.init_size = None
    parameters.max_iter = 0
    _ = model.set_params(parameters)
    with assert_raises(): _ = model.fit(x)
    var one_step = MiniBatchKMeans[dtype](1, max_iter=1, compute_labels=False, random_state=0)
    with assert_raises(): _ = one_step.fit(x)
    var identical = nm.ones[dtype](nm.Shape(9, 3))
    var ties = MiniBatchKMeans[dtype](5, batch_size=5, max_iter=12, random_state=0)
    _ = ties.fit(identical)
    assert_equal(ties.n_steps_, 12)
    assert_equal(ties._counts.item(0), 60)
    for i in range(9): assert_equal(ties.labels_.item(i), 0)


def main() raises:
    exercise[DType.float32]()
    exercise[DType.float64]()
    var model = MiniBatchKMeans(1, random_state=0)
    var x = nm.ones[DType.float64](nm.Shape(1, 1))
    _ = model.partial_fit(x)
    print("PASS MiniBatchKMeans lifecycle, configuration, ownership and incremental contracts")
