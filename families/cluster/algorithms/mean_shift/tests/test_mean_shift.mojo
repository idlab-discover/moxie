import numojo as nm
from std.testing import assert_equal, assert_true, assert_false, assert_raises
from moxie.base import clone
from moxie._random import RandomState, seed_global_random_state
from moxie.cluster import MeanShift, mean_shift, estimate_bandwidth, get_bin_seeds, PredictiveClusterer

def dispatch[T: PredictiveClusterer](mut model: T, x: T.Input, y: Optional[T.Target]) raises -> T.Labels:
    return model.fit_predict(x, y)

def check[dtype: DType]() raises:
    var model = MeanShift[dtype]()
    assert_false(Bool(model.params.bandwidth))
    assert_false(Bool(model.params.seeds))
    assert_false(model.params.bin_seeding)
    assert_true(model.params.cluster_all)
    assert_equal(model.params.min_bin_freq, 1)
    assert_equal(model.params.max_iter, 300)
    assert_false(Bool(model.params.n_jobs))
    assert_false(model.__sklearn_is_fitted__())
    var x = nm.zeros[dtype](nm.Shape(5,1))
    for i in range(5): x[nm.Item(i,0)] = SIMD[dtype,1](0 if i < 2 else (4 if i < 4 else 10))
    with assert_raises(): _ = model.predict(x)
    _ = model.set_params(bandwidth=Optional[Float64](1))
    var labels = dispatch(model, x, Optional[nm.NDArray[dtype]](None))
    assert_equal(model.cluster_centers_.shape[0], 3)
    assert_equal(model.cluster_centers_.item(0,0), SIMD[dtype,1](4))
    assert_equal(model.cluster_centers_.item(1,0), SIMD[dtype,1](0))
    assert_equal(model.n_iter_, 0)
    assert_equal(model.n_features_in_, 1)
    assert_equal(labels.item(0), Int64(1))
    labels[nm.Item(0)] = 99
    assert_equal(model.labels_.item(0), Int64(1))
    var fresh = clone(model)
    assert_false(fresh.__sklearn_is_fitted__())
    assert_equal(fresh.cluster_centers_.size, 0)
    assert_equal(fresh.params.bandwidth.value(), Float64(1))
    var seeds = nm.zeros[dtype](nm.Shape(1,1))
    var params = model.get_params()
    params.seeds = seeds.copy()
    params.cluster_all = False
    _ = model.set_params(params)
    params.seeds.value()[nm.Item(0,0)] = 99
    seeds[nm.Item(0,0)] = 99
    assert_equal(model.params.seeds.value().item(0,0), SIMD[dtype,1](0))
    var seeded_clone = clone(model)
    seeded_clone.params.seeds.value()[nm.Item(0,0)] = 80
    assert_equal(model.params.seeds.value().item(0,0), SIMD[dtype,1](0))
    _ = model.fit(x, x.copy())
    assert_equal(model.labels_.item(4), Int64(-1))
    var predicted = model.predict(x)
    assert_equal(predicted.item(4), Int64(0))
    x[nm.Item(0,0)] = 100
    assert_equal(model.cluster_centers_.item(0,0), SIMD[dtype,1](0))
    _ = model.set_params(seeds=Optional[nm.NDArray[dtype]](None), bandwidth=Optional[Float64](None), bin_seeding=True, cluster_all=True, max_iter=0, min_bin_freq=1, n_jobs=Optional[Int](2))
    var constant = nm.full[dtype](nm.Shape(10,1), 3)
    _ = model.fit(constant)
    assert_equal(model.cluster_centers_.shape[0],1)
    assert_equal(model.cluster_centers_.item(0,0),SIMD[dtype,1](3))
    assert_equal(model.n_iter_,0)
    assert_equal(estimate_bandwidth(constant),Float64(0))
    var zero_bins = get_bin_seeds(constant,0)
    zero_bins[nm.Item(0,0)] = 12
    assert_equal(constant.item(0,0),SIMD[dtype,1](3))
    var helper = mean_shift(constant)
    assert_equal(helper.cluster_centers.item(0,0), SIMD[dtype,1](3))
    assert_equal(helper.labels.item(0),Int64(0))
    var reverse = x.view_with_layout(nm.Shape(5,1),nm.Strides(-1,1),4)
    var reversed_model = MeanShift[dtype](bandwidth=1.0)
    _ = reversed_model.fit(reverse)
    var contiguous = nm.zeros[dtype](nm.Shape(5,1))
    for i in range(5): contiguous[nm.Item(i,0)] = reverse.item(i,0)
    var normal = mean_shift(contiguous,bandwidth=1.0)
    for i in range(5): assert_equal(normal.labels.item(i),reversed_model.labels_.item(i))
    var state = RandomState(17)
    var expected_state = RandomState(17)
    _ = estimate_bandwidth(x,n_samples=3,random_state=state)
    _ = expected_state.permutation(5)
    assert_equal(state.next_uint32(),expected_state.next_uint32())
    _ = estimate_bandwidth(x,random_state=state)
    assert_equal(state.next_uint32(),expected_state.next_uint32())
    assert_equal(estimate_bandwidth(x,n_samples=3),estimate_bandwidth(x,n_samples=3))
    seed_global_random_state(17)
    var default_bandwidth = estimate_bandwidth(x,n_samples=3,random_state=None)
    assert_equal(default_bandwidth,estimate_bandwidth(x,n_samples=3,random_state=17))
    var bad = nm.zeros[dtype](nm.Shape(1))
    with assert_raises(): _ = model.fit(bad)
    with assert_raises(): _ = model.predict(bad)
    var empty = nm.zeros[dtype](nm.Shape(0,1))
    with assert_raises(): _ = model.fit(empty)
    var mismatch = nm.zeros[dtype](nm.Shape(1,2))
    with assert_raises(): _ = model.predict(mismatch)
    with assert_raises(): _ = mean_shift(x,seeds=mismatch.copy())
    with assert_raises(): _ = mean_shift(x,seeds=empty.copy())
    with assert_raises(): _ = mean_shift(x,bandwidth=0.0)
    with assert_raises(): _ = mean_shift(x,bandwidth=-1.0)
    with assert_raises(): _ = mean_shift(x,max_iter=-1)
    with assert_raises(): _ = mean_shift(x,min_bin_freq=0)
    with assert_raises(): _ = mean_shift(x,n_jobs=0)
    with assert_raises(): _ = estimate_bandwidth(x,quantile=-.1)
    with assert_raises(): _ = estimate_bandwidth(x,quantile=1.1)
    with assert_raises(): _ = estimate_bandwidth(x,n_samples=0)
    with assert_raises(): _ = estimate_bandwidth(x,random_state=-1)
    with assert_raises(): _ = get_bin_seeds(x,-1)
    with assert_raises(): _ = get_bin_seeds(x,1,0)
    with assert_raises(): _ = mean_shift(x,bandwidth=.1,bin_seeding=True,min_bin_freq=99)
    seeds[nm.Item(0,0)] = -1000
    with assert_raises(): _ = mean_shift(x,seeds=seeds.copy(),bandwidth=.1)
    var nonfinite = nm.full[dtype](nm.Shape(1,1),SIMD[dtype,1](Float64("inf")))
    with assert_raises(): _ = model.fit(nonfinite)
    with assert_raises(): _ = model.predict(nonfinite)
    with assert_raises(): _ = get_bin_seeds(nonfinite,1)
    with assert_raises(): _ = estimate_bandwidth(nonfinite)
    with assert_raises(): _ = mean_shift(x,bandwidth=Float64("inf"))
    with assert_raises(): _ = get_bin_seeds(x,Float64("inf"))
    with assert_raises(): _ = estimate_bandwidth(x,quantile=Float64("nan"))
    # Failed refits keep the last successful learned state.
    assert_equal(model.cluster_centers_.item(0,0),SIMD[dtype,1](3))
    var next_x = nm.zeros[dtype](nm.Shape(2,2))
    _ = model.fit(next_x)
    assert_equal(model.n_features_in_,2)

def main() raises:
    check[DType.float32]()
    check[DType.float64]()
    print("PASS: MeanShift lifecycle, native API, RNG and invalid inputs")
