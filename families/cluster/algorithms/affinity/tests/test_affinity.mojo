import numojo as nm
from std.testing import assert_equal, assert_true, assert_false, assert_raises
from moxie.cluster import AffinityPropagation, affinity_propagation
from moxie.cluster._affinity_propagation import Preference
from moxie._random import RandomState
from moxie.base import clone


def exercise[dtype: DType]() raises:
    var x = nm.zeros[dtype](nm.Shape(6, 2))
    for i in range(6):
        x[nm.Item(i, 0)] = SIMD[dtype, 1](1 if i < 3 else 4)
        x[nm.Item(i, 1)] = SIMD[dtype, 1](2 if i % 3 == 0 else (4 if i % 3 == 1 else 0))
    var model = AffinityPropagation[dtype](random_state=5)
    with assert_raises():
        _ = model.predict(x)
    var labels = model.fit_predict(x)
    assert_true(model.__sklearn_is_fitted__())
    assert_equal(model.n_features_in_, 2)
    assert_equal(model.cluster_centers_indices_.size, 2)
    var predicted = model.predict(x)
    for i in range(6):
        assert_equal(Int(labels.item(i)), i // 3)
        assert_equal(labels.item(i), predicted.item(i))
    var duplicate = clone(model)
    assert_false(duplicate.__sklearn_is_fitted__())
    assert_equal(duplicate.labels_.size, 0)
    _ = model.fit(x)
    for i in range(6):
        assert_equal(model.labels_.item(i), labels.item(i))
    var original = model.cluster_centers_.value().item(0, 0)
    x[nm.Item(0, 0)] = SIMD[dtype, 1](99)
    assert_equal(model.cluster_centers_.value().item(0, 0), original)
    var wrong = nm.zeros[dtype](nm.Shape(2, 3))
    with assert_raises():
        _ = model.predict(wrong)
    _ = model.set_params(damping=0.2)
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(damping=0.9, max_iter=0)
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(max_iter=200, convergence_iter=0)
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(convergence_iter=15, affinity="bad")
    with assert_raises(): _ = model.fit(x)
    _ = model.set_params(affinity="precomputed")
    with assert_raises(): _ = model.fit(x)
    var empty = nm.zeros[dtype](nm.Shape(0, 2))
    with assert_raises(): _ = model.fit(empty)
    var rank1 = nm.zeros[dtype](nm.Shape(3))
    with assert_raises(): _ = model.fit(rank1)
    var singleton = nm.zeros[dtype](nm.Shape(1, 1))
    _ = model.fit(singleton)
    assert_equal(model.n_iter_, 0)
    assert_equal(model.labels_.item(0), Int64(0))
    assert_false(Bool(model.cluster_centers_))
    with assert_raises(): _ = model.predict(singleton)
    var same = nm.zeros[dtype](nm.Shape(8, 8))
    var all_one = affinity_propagation(same, random_state=42, return_n_iter=True)
    assert_equal(all_one.cluster_centers_indices.size, 1)
    assert_equal(all_one.n_iter.value(), 0)
    var all_many = affinity_propagation(same, preference=Preference(1), random_state=42)
    assert_equal(all_many.cluster_centers_indices.size, 8)
    assert_false(Bool(all_many.n_iter))
    for i in range(8): assert_equal(Int(all_many.labels.item(i)), i)
    var nonconverged = nm.zeros[dtype](nm.Shape(3, 2))
    nonconverged[nm.Item(1, 0)] = SIMD[dtype, 1](1)
    nonconverged[nm.Item(1, 1)] = SIMD[dtype, 1](1)
    nonconverged[nm.Item(2, 0)] = SIMD[dtype, 1](-2)
    nonconverged[nm.Item(2, 1)] = SIMD[dtype, 1](-2)
    var failure = AffinityPropagation[dtype](preference=Preference(-10), max_iter=1, random_state=82)
    _ = failure.fit(nonconverged)
    assert_false(failure.converged_)
    assert_equal(failure.cluster_centers_indices_.size, 0)
    var negative = failure.predict(nonconverged)
    for i in range(3): assert_equal(negative.item(i), Int64(-1))
    var sim = nm.zeros[dtype](nm.Shape(3, 3))
    for i in range(3):
        for j in range(3): sim[nm.Item(i, j)] = SIMD[dtype, 1](-(i-j)*(i-j))
    var saved = sim.copy()
    var copied = affinity_propagation(sim, preference=Preference(-10), random_state=0)
    assert_equal(sim.item(0, 0), saved.item(0, 0))
    var inplace = affinity_propagation(sim, preference=Preference(-10), copy=False, random_state=0)
    assert_true(sim.item(0, 0) != saved.item(0, 0))
    for i in range(3): assert_equal(inplace.labels.item(i), copied.labels.item(i))
    var rng = RandomState(0)
    var seeded = AffinityPropagation[dtype](affinity="precomputed")
    _ = seeded.fit(saved, rng)
    var after = rng.next_uint32()
    var control = RandomState(0)
    for _ in range(9): _ = control.standard_normal()
    assert_equal(after, control.next_uint32())
    var bad_pref = nm.zeros[DType.float64](nm.Shape(2))
    _ = seeded.set_params(preference=Preference(bad_pref))
    with assert_raises(): _ = seeded.fit(saved, rng)
    var no_seed = AffinityPropagation[dtype]()
    with assert_raises(): _ = no_seed.fit(saved)
    var layout = saved.view_with_layout(nm.Shape(3,3), nm.NDArrayStrides(-3,-1), 8)
    _ = seeded.set_params(preference=Preference())
    _ = seeded.fit(layout, rng)
    assert_equal(seeded.labels_.size, 3)
    var invalid = saved.copy()
    invalid[nm.Item(0, 0)] = Float64("nan").cast[dtype]()
    with assert_raises(): _ = seeded.fit(invalid, rng)
    invalid[nm.Item(0, 0)] = Float64("inf").cast[dtype]()
    with assert_raises(): _ = seeded.fit(invalid, rng)
    var bad_scalar = AffinityPropagation[dtype](preference=Preference(Float64("nan")), random_state=0)
    with assert_raises(): _ = bad_scalar.fit(saved)
    var bad_seed = AffinityPropagation[dtype](random_state=-1)
    with assert_raises(): _ = bad_seed.fit(saved)
    # Degenerate matrices do not consume perturbation draws.
    var no_draws = RandomState(19)
    var before = no_draws.copy()
    var early = affinity_propagation(same, no_draws)
    assert_equal(no_draws.next_uint32(), before.next_uint32())
    # Refit replaces dimensions and removes prior Euclidean centers.
    var repeat = AffinityPropagation[dtype](random_state=5)
    _ = repeat.fit(x)
    _ = repeat.set_params(affinity="precomputed")
    _ = repeat.fit(saved)
    assert_equal(repeat.n_features_in_, 3)
    assert_false(Bool(repeat.cluster_centers_))
    var config = repeat.get_params()
    var prefs = nm.zeros[DType.float64](nm.Shape(3))
    config.preference = Preference(prefs)
    _ = repeat.set_params(config)
    prefs[nm.Item(0)] = 100
    assert_equal(repeat.get_params().preference.values.value().item(0), Float64(0))
    print("PASS native affinity dtype", dtype)


def main() raises:
    exercise[DType.float64]()
    exercise[DType.float32]()
