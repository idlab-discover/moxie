import numojo as nm
from std.testing import assert_equal, assert_true, assert_raises
from moxie._labels import StringTarget
from moxie.neighbors import KNeighborsClassifier, RadiusNeighborsClassifier, NearestCentroid, NeighborhoodComponentsAnalysis, NoNCACallback
from moxie.neighbors._distance import Metric
from moxie.base import clone

def main() raises:
    var x = nm.zeros[DType.float32](nm.Shape(4,1))
    for i in range(4): x.unsafe_set(i,Float32(i))
    var labels = nm.zeros[DType.int64](nm.Shape(4))
    labels.unsafe_set(0,Int64(9007199254740992))
    labels.unsafe_set(1,Int64(9007199254740993))
    labels.unsafe_set(2,Int64(-9223372036854775807))
    labels.unsafe_set(3,Int64(9223372036854775807))
    var model = KNeighborsClassifier[DType.float32,Metric[DType.float32],nm.NDArray[DType.int64]](1)
    model.fit(x,labels)
    var pred = model.predict(x.view())
    for i in range(4):
        assert_equal(pred.unsafe_get(i),labels.unsafe_get(i))
        print("I",i,pred.unsafe_get(i))
    assert_equal(model.classes_[0].shape[0],4)
    for i in range(4): print("IC",i,model.classes_[0].unsafe_get(i))
    assert_equal(model.score(x,labels),1)
    assert_equal(model.score(None,labels),0)
    var fresh = clone(model)
    assert_true(not fresh.__sklearn_is_fitted__())
    var single_strings = StringTarget(["z","a","z","a"])
    var sc = KNeighborsClassifier[DType.float32,Metric[DType.float32],StringTarget](1)
    sc.fit(x,single_strings)
    assert_equal(sc.score(x,single_strings),1)
    var centroid = NearestCentroid[DType.float32,StringTarget]()
    centroid.fit(x,single_strings)
    assert_equal(centroid.classes_.get(0),"a")
    assert_equal(centroid.predict(x).rows(),4)
    var nca = NeighborhoodComponentsAnalysis[DType.float32,NoNCACallback,StringTarget](init="identity",max_iter=1)
    nca.fit(x,single_strings)
    assert_equal(nca.transform(x).shape[0],4)
    var strings = StringTarget(["z","red","a","blue","z","blue","a","red"],4,2)
    var c = KNeighborsClassifier[DType.float32,Metric[DType.float32],StringTarget](1)
    c.fit(x,strings)
    var sp = c.predict(x.view())
    assert_equal(sp.rank(),2)
    for i in range(4):
        for col in range(2): print("S",i,col,sp.get(i,col))
    assert_equal(c.classes_[0].get(0),"a")
    assert_equal(c.classes_[1].get(0),"blue")
    for col in range(2):
        for i in range(c.classes_[col].rows()): print("SC",col,i,c.classes_[col].get(i))
    with assert_raises(): _ = c.score(x,strings)
    strings.set(0,"a")
    with assert_raises(): _ = c.score(x,strings)
    var probabilities = c.predict_proba(x.view())
    assert_equal(len(probabilities),2)
    var r = RadiusNeighborsClassifier[DType.float32,Metric[DType.float32],StringTarget](0.1,outlier_label=StringTarget(["missing","red"]))
    r.fit(x,strings)
    var q = nm.full[DType.float32](nm.Shape(1,1),99)
    var rp = r.predict(q.view())
    assert_equal(rp.get(0,0),"missing")
    assert_equal(rp.get(0,1),"red")
    var params = r.get_params()
    params.outlier_most_frequent = True
    r.set_params(params)
    r.fit(x,strings)
    rp = r.predict(q.view())
    assert_equal(rp.get(0,0),"a")
    assert_equal(rp.get(0,1),"blue")
    var binary = nm.zeros[DType.int64](nm.Shape(4,2))
    binary.unsafe_set(1,1)
    binary.unsafe_set(2,1)
    binary.unsafe_set(7,1)
    model.fit(x,binary)
    assert_equal(model.score(x,binary),1)
    var bp = model.predict(x.view())
    assert_equal(bp.ndim,2)
    binary.unsafe_set(0,1)
    assert_equal(model.score(x,binary),0.75)
    print("PASS string, exact Int64, multioutput, multilabel and outlier labels")
