import numojo as nm
from std.math import isnan
from std.testing import assert_equal, assert_true, assert_raises
from moxie.base import clone
from moxie.neighbors import NearestNeighbors, KNeighborsClassifier, KNeighborsRegressor, RadiusNeighborsClassifier, RadiusNeighborsRegressor

def exercise[dtype: DType]() raises:
    var x = nm.zeros[dtype](nm.Shape(4,1))
    x.unsafe_set(2,2)
    x.unsafe_set(3,4)
    var y = nm.zeros[dtype](nm.Shape(4))
    y.unsafe_set(0,2)
    y.unsafe_set(1,4)
    y.unsafe_set(2,8)
    y.unsafe_set(3,10)
    var nn = NearestNeighbors[dtype](2)
    with assert_raises(): _ = nn.kneighbors()
    nn.fit(x)
    var neighbors = nn.kneighbors()
    assert_equal(neighbors.indices[0],1)
    var reg = KNeighborsRegressor[dtype](3,weights="distance")
    with assert_raises(): _ = reg.predict(x.view())
    reg.fit(x,y)
    var pred = reg.predict(x.view())
    assert_equal(Float64(pred.unsafe_get(0)),3)
    var clf = KNeighborsClassifier[dtype](3,weights="distance")
    clf.fit(x,y)
    var label = clf.predict(x.view())
    assert_equal(Float64(label.unsafe_get(0)),2)
    var probs = clf.predict_proba(x.view())
    assert_equal(Float64(probs[0].unsafe_get(0)),0.5)
    assert_equal(Float64(probs[0].unsafe_get(1)),0.5)
    var fresh = clone(clf)
    assert_true(not fresh.__sklearn_is_fitted__())
    var rc = RadiusNeighborsClassifier[dtype](0)
    rc.fit(x,y)
    var rp = rc.predict(x.view())
    assert_equal(Float64(rp.unsafe_get(0)),2)
    var rr = RadiusNeighborsRegressor[dtype](0)
    rr.fit(x,y)
    var rrp = rr.predict(x.view())
    assert_equal(Float64(rrp.unsafe_get(0)),3)
    assert_true(clf.score(x,y) > 0)
    assert_true(reg.score(x,y) > 0)


def edge_cases[dtype: DType]() raises:
    var x = nm.zeros[dtype](nm.Shape(4, 2))
    for i in range(4): x.unsafe_set(i*2, Float64(i).cast[dtype]())
    var y = nm.zeros[dtype](nm.Shape(4, 2))
    for i in range(4):
        y.unsafe_set(i*2, Float64(i%2).cast[dtype]())
        y.unsafe_set(i*2+1, Float64(i%2).cast[dtype]())
    var c = KNeighborsClassifier[dtype](1)
    c.fit(x,y)
    var pred = c.predict(x.view())
    assert_equal(pred.ndim,2)
    assert_equal(pred.shape[1],2)
    assert_equal(c.score(x,y),1)
    var sample_weight = nm.ones[dtype](nm.Shape(4))
    assert_equal(c.score(x,y,sample_weight.view()),1)
    var column = nm.zeros[dtype](nm.Shape(4,1))
    var column_clf = KNeighborsClassifier[dtype](1)
    column_clf.fit(x,column)
    var flattened = column_clf.predict(x.view())
    assert_equal(flattened.ndim,1)
    assert_true(not column_clf.outputs_2d_)
    var general = y.copy()
    general.unsafe_set(0,3)
    var general_clf = KNeighborsClassifier[dtype](1)
    general_clf.fit(x,general)
    with assert_raises(): _ = general_clf.score(x,general)
    var r = KNeighborsRegressor[dtype](1)
    r.fit(x,y)
    assert_equal(r.score(x,y),1)
    # Failed validation is transactional; fit owns both X and y snapshots.
    var invalid = nm.zeros[dtype](nm.Shape(3))
    with assert_raises(): c.fit(x,invalid)
    assert_equal(c.n_samples_fit_,4)
    x.unsafe_set(0,99)
    y.unsafe_set(0,99)
    var unchanged = c.predict()
    assert_equal(Float64(c.classes_[0].unsafe_get(0)),0)
    var fresh = clone(c)
    with assert_raises(): _ = fresh.predict()
    var params = c.get_params()
    params.neighbors.n_neighbors = 2
    c.set_params(params)
    assert_equal(c.get_params().neighbors.n_neighbors,2)
    assert_true(c.__sklearn_is_fitted__())
    var k = c.kneighbors(None,1,False)
    assert_true(not k.distances)
    var bad = NearestNeighbors[dtype](algorithm="kd_tree")
    bad.fit(x)
    assert_equal(bad._fit_method,"kd_tree")
    var bad_ball = NearestNeighbors[dtype](algorithm="ball_tree")
    bad_ball.fit(x)
    assert_equal(bad_ball._fit_method,"ball_tree")
    var pre = NearestNeighbors[dtype](metric="precomputed")
    with assert_raises(): pre.fit(x)
    var small = nm.zeros[dtype](nm.Shape(1,2))
    var single = NearestNeighbors[dtype](1)
    single.fit(small)
    with assert_raises(): _ = single.kneighbors()
    var rad = RadiusNeighborsClassifier[dtype](0)
    rad.fit(x,y)
    var far = nm.zeros[dtype](nm.Shape(1,2))
    far.unsafe_set(0,1000)
    with assert_raises(): _ = rad.predict(far.view())
    var outliers = nm.zeros[dtype](nm.Shape(2))
    outliers.unsafe_set(0,-1)
    outliers.unsafe_set(1,-2)
    var explicit_outlier = RadiusNeighborsClassifier[dtype](0,outlier_label=outliers.view())
    explicit_outlier.fit(x,y)
    var out = explicit_outlier.predict(far.view())
    assert_equal(Float64(out.unsafe_get(0)),-1)
    assert_equal(Float64(out.unsafe_get(1)),-2)
    var zero = explicit_outlier.predict_proba(far.view())
    for col in range(len(zero)):
        for j in range(zero[col].shape[1]): assert_equal(Float64(zero[col].unsafe_get(j)),0)
    var rr = RadiusNeighborsRegressor[dtype](0)
    rr.fit(x,y)
    var empty = rr.predict(far.view())
    assert_true(isnan(empty.unsafe_get(0)))
    var missing = nm.zeros[dtype](nm.Shape(4))
    missing.unsafe_set(0,Float64("nan").cast[dtype]())
    with assert_raises(): r.fit(x,missing)
    var continuous = nm.zeros[dtype](nm.Shape(4))
    continuous.unsafe_set(1,0.5)
    with assert_raises(): c.fit(x,continuous)
    # Positive stride and offset input/target slices.
    var backing = nm.zeros[dtype](nm.Shape(8,4))
    for i in range(8):
        for j in range(4): backing.unsafe_set(i*4+j,Float64(i+j).cast[dtype]())
    var strided = backing.view_with_layout(nm.Shape(4,2), nm.NDArrayStrides(8,2),1)
    var sy = nm.zeros[dtype](nm.Shape(4))
    for i in range(4): sy.unsafe_set(i,Float64(i).cast[dtype]())
    var stride_reg = KNeighborsRegressor[dtype](1)
    stride_reg.fit(strided,sy)
    var sp = stride_reg.predict(strided.view())
    for i in range(4): assert_equal(Float64(sp.unsafe_get(i)),Float64(i))

def main() raises:
    exercise[DType.float32]()
    exercise[DType.float64]()
    edge_cases[DType.float32]()
    edge_cases[DType.float64]()
    print("PASS public nearest, KNN and radius estimators")
