import numojo as nm
from std.math import isnan
from std.testing import assert_equal, assert_true, assert_raises
from moxie.base import clone
from moxie.neighbors import NearestNeighbors, KNeighborsClassifier, KNeighborsRegressor, RadiusNeighborsClassifier, RadiusNeighborsRegressor
from moxie.neighbors import LocalOutlierFactor, KernelDensity, NearestCentroid

def exercise[dtype: DType]() raises:
    var x = nm.zeros[dtype](nm.Shape(4,1))
    x.unsafe_set(2,2)
    x.unsafe_set(3,4)
    var y = nm.zeros[dtype](nm.Shape(4))
    y.unsafe_set(0,2)
    y.unsafe_set(1,4)
    y.unsafe_set(2,8)
    y.unsafe_set(3,10)
    var nn = NearestNeighbors[dtype](2)
    with assert_raises(): _ = nn.kneighbors()
    nn.fit(x)
    var neighbors = nn.kneighbors()
    assert_equal(neighbors.indices[0],1)
    var reg = KNeighborsRegressor[dtype](3,weights="distance")
    with assert_raises(): _ = reg.predict(x.view())
    reg.fit(x,y)
    var pred = reg.predict(x.view())
    assert_equal(Float64(pred.unsafe_get(0)),3)
    var clf = KNeighborsClassifier[dtype](3,weights="distance")
    clf.fit(x,y)
    var label = clf.predict(x.view())
    assert_equal(Float64(label.unsafe_get(0)),2)
    var probs = clf.predict_proba(x.view())
    assert_equal(Float64(probs[0].unsafe_get(0)),0.5)
    assert_equal(Float64(probs[0].unsafe_get(1)),0.5)
    var fresh = clone(clf)
    assert_true(not fresh.__sklearn_is_fitted__())
    var rc = RadiusNeighborsClassifier[dtype](0)
    rc.fit(x,y)
    var rp = rc.predict(x.view())
    assert_equal(Float64(rp.unsafe_get(0)),2)
    var rr = RadiusNeighborsRegressor[dtype](0)
    rr.fit(x,y)
    var rrp = rr.predict(x.view())
    assert_equal(Float64(rrp.unsafe_get(0)),3)
    assert_true(clf.score(x,y) > 0)
    assert_true(reg.score(x,y) > 0)


def edge_cases[dtype: DType]() raises:
    var x = nm.zeros[dtype](nm.Shape(4, 2))
    for i in range(4): x.unsafe_set(i*2, Float64(i).cast[dtype]())
    var y = nm.zeros[dtype](nm.Shape(4, 2))
    for i in range(4):
        y.unsafe_set(i*2, Float64(i%2).cast[dtype]())
        y.unsafe_set(i*2+1, Float64(i%2).cast[dtype]())
    var c = KNeighborsClassifier[dtype](1)
    c.fit(x,y)
    var pred = c.predict(x.view())
    assert_equal(pred.ndim,2)
    assert_equal(pred.shape[1],2)
    assert_equal(c.score(x,y),1)
    var sample_weight = nm.ones[dtype](nm.Shape(4))
    assert_equal(c.score(x,y,sample_weight.view()),1)
    var column = nm.zeros[dtype](nm.Shape(4,1))
    var column_clf = KNeighborsClassifier[dtype](1)
    column_clf.fit(x,column)
    var flattened = column_clf.predict(x.view())
    assert_equal(flattened.ndim,1)
    assert_true(not column_clf.outputs_2d_)
    var general = y.copy()
    general.unsafe_set(0,3)
    var general_clf = KNeighborsClassifier[dtype](1)
    general_clf.fit(x,general)
    with assert_raises(): _ = general_clf.score(x,general)
    var r = KNeighborsRegressor[dtype](1)
    r.fit(x,y)
    assert_equal(r.score(x,y),1)
    # Failed validation is transactional; fit owns both X and y snapshots.
    var invalid = nm.zeros[dtype](nm.Shape(3))
    with assert_raises(): c.fit(x,invalid)
    assert_equal(c.n_samples_fit_,4)
    x.unsafe_set(0,99)
    y.unsafe_set(0,99)
    var unchanged = c.predict()
    assert_equal(Float64(c.classes_[0].unsafe_get(0)),0)
    var fresh = clone(c)
    with assert_raises(): _ = fresh.predict()
    var params = c.get_params()
    params.neighbors.n_neighbors = 2
    c.set_params(params)
    assert_equal(c.get_params().neighbors.n_neighbors,2)
    assert_true(c.__sklearn_is_fitted__())
    var k = c.kneighbors(None,1,False)
    assert_true(not k.distances)
    var bad = NearestNeighbors[dtype](algorithm="kd_tree")
    bad.fit(x)
    assert_equal(bad._fit_method,"kd_tree")
    var bad_ball = NearestNeighbors[dtype](algorithm="ball_tree")
    bad_ball.fit(x)
    assert_equal(bad_ball._fit_method,"ball_tree")
    var pre = NearestNeighbors[dtype](metric="precomputed")
    with assert_raises(): pre.fit(x)
    var small = nm.zeros[dtype](nm.Shape(1,2))
    var single = NearestNeighbors[dtype](1)
    single.fit(small)
    with assert_raises(): _ = single.kneighbors()
    var rad = RadiusNeighborsClassifier[dtype](0)
    rad.fit(x,y)
    var far = nm.zeros[dtype](nm.Shape(1,2))
    far.unsafe_set(0,1000)
    with assert_raises(): _ = rad.predict(far.view())
    var outliers = nm.zeros[dtype](nm.Shape(2))
    outliers.unsafe_set(0,-1)
    outliers.unsafe_set(1,-2)
    var explicit_outlier = RadiusNeighborsClassifier[dtype](0,outlier_label=outliers.view())
    explicit_outlier.fit(x,y)
    var out = explicit_outlier.predict(far.view())
    assert_equal(Float64(out.unsafe_get(0)),-1)
    assert_equal(Float64(out.unsafe_get(1)),-2)
    var zero = explicit_outlier.predict_proba(far.view())
    for col in range(len(zero)):
        for j in range(zero[col].shape[1]): assert_equal(Float64(zero[col].unsafe_get(j)),0)
    var rr = RadiusNeighborsRegressor[dtype](0)
    rr.fit(x,y)
    var empty = rr.predict(far.view())
    assert_true(isnan(empty.unsafe_get(0)))
    var missing = nm.zeros[dtype](nm.Shape(4))
    missing.unsafe_set(0,Float64("nan").cast[dtype]())
    with assert_raises(): r.fit(x,missing)
    var continuous = nm.zeros[dtype](nm.Shape(4))
    continuous.unsafe_set(1,0.5)
    with assert_raises(): c.fit(x,continuous)
    # Positive stride and offset input/target slices.
    var backing = nm.zeros[dtype](nm.Shape(8,4))
    for i in range(8):
        for j in range(4): backing.unsafe_set(i*4+j,Float64(i+j).cast[dtype]())
    var strided = backing.view_with_layout(nm.Shape(4,2), nm.NDArrayStrides(8,2),1)
    var sy = nm.zeros[dtype](nm.Shape(4))
    for i in range(4): sy.unsafe_set(i,Float64(i).cast[dtype]())
    var stride_reg = KNeighborsRegressor[dtype](1)
    stride_reg.fit(strided,sy)
    var sp = stride_reg.predict(strided.view())
    for i in range(4): assert_equal(Float64(sp.unsafe_get(i)),Float64(i))

def keyword_params[dtype: DType]() raises:
    # Keyword set_params replaces only the supplied fields, keeps fitted state
    # (sklearn semantics), and query-time options apply without refitting.
    var x = nm.zeros[dtype](nm.Shape(6,1))
    for i in range(5): x.unsafe_set(i,Float64(i).cast[dtype]())
    x.unsafe_set(5,20)
    var y = nm.zeros[dtype](nm.Shape(6))
    for i in range(6): y.unsafe_set(i,Float64(i%2).cast[dtype]())
    var nn = NearestNeighbors[dtype](2)
    nn.fit(x)
    _ = nn.set_params(n_neighbors=3, radius=1.5, leaf_size=7)
    var p = nn.get_params()
    assert_equal(p.n_neighbors,3)
    assert_equal(p.radius,1.5)
    assert_equal(p.leaf_size,7)
    assert_equal(p.algorithm,"auto")
    assert_equal(p.metric,"minkowski")
    assert_true(nn.__sklearn_is_fitted__())
    assert_equal(nn.kneighbors().k,3)
    var within = nn.radius_neighbors(None)
    assert_equal(within.offsets[1],1)  # x=0 sees only x=1 within 1.5 (self excluded)
    assert_equal(within.offsets[2],3)  # x=1 sees x=0 and x=2
    _ = nn.set_params(algorithm="brute", metric="manhattan").fit(x)
    assert_equal(nn._fit_method,"brute")
    assert_equal(nn.effective_metric_,"manhattan")
    var clf = KNeighborsClassifier[dtype](3)
    clf.fit(x,y)
    _ = clf.set_params(n_neighbors=1, weights="distance")
    assert_equal(clf.get_params().neighbors.n_neighbors,1)
    assert_equal(clf.get_params().weights,"distance")
    var exact = clf.predict(x.view())
    for i in range(6): assert_equal(Float64(exact.unsafe_get(i)),Float64(i%2))
    var reg = KNeighborsRegressor[dtype](3)
    reg.fit(x,y)
    _ = reg.set_params(n_neighbors=1, p=1.0)
    assert_equal(reg.get_params().neighbors.p,1.0)
    var r = reg.predict(x.view())
    for i in range(6): assert_equal(Float64(r.unsafe_get(i)),Float64(i%2))
    var rc = RadiusNeighborsClassifier[dtype](0.5)
    rc.fit(x,y)
    var labels = nm.zeros[dtype](nm.Shape(1))
    labels.unsafe_set(0,-1)
    _ = rc.set_params(radius=0.1, outlier_label=labels.copy())
    assert_equal(rc.get_params().neighbors.radius,0.1)
    var far = nm.zeros[dtype](nm.Shape(1,1))
    far.unsafe_set(0,100)
    with assert_raises(): _ = rc.predict(far.view())  # outlier labels are resolved at fit, as in sklearn
    rc.fit(x,y)
    assert_equal(Float64(rc.predict(far.view()).unsafe_get(0)),-1)
    _ = rc.set_params(outlier_most_frequent=True).fit(x,y)
    assert_equal(Float64(rc.predict(far.view()).unsafe_get(0)),0)
    var rr = RadiusNeighborsRegressor[dtype](0.5)
    rr.fit(x,y)
    _ = rr.set_params(radius=1.5, weights="distance")
    assert_equal(rr.get_params().neighbors.radius,1.5)
    assert_equal(rr.get_params().weights,"distance")
    var lof = LocalOutlierFactor[dtype](2)
    with assert_raises(contains="NotFittedError"): _ = lof.kneighbors()
    lof.fit(x)
    # Each novelty-gated method names itself, like sklearn's AttributeError.
    with assert_raises(contains="predict requires novelty=True"): _ = lof.predict(x)
    with assert_raises(contains="decision_function requires novelty=True"): _ = lof.decision_function(x)
    with assert_raises(contains="score_samples requires novelty=True"): _ = lof.score_samples(x)
    # LOF exposes KNeighborsMixin.kneighbors; X=None excludes each training row.
    var own = lof.kneighbors()
    assert_equal(own.k,2)
    assert_equal(own.indices[0],1)
    assert_equal(own.indices[1],2)
    assert_equal(Float64(own.distances.value().unsafe_get(1)),2)
    var q = nm.zeros[dtype](nm.Shape(1,1))
    q.unsafe_set(0,30)
    var outside = lof.kneighbors(q.copy(),1,False)
    assert_equal(outside.indices[0],5)
    assert_true(not outside.distances)
    _ = lof.set_params(n_neighbors=3, contamination=0.25, novelty=True)
    assert_equal(lof.get_params().neighbors.n_neighbors,3)
    assert_equal(lof.get_params().contamination.value(),0.25)
    assert_true(lof.get_params().novelty)
    assert_equal(lof.n_neighbors_,2)  # learned state is kept until refit
    lof.fit(x)
    assert_equal(lof.n_neighbors_,3)
    assert_equal(lof.kneighbors().k,3)
    _ = lof.score_samples(q)
    var kde = KernelDensity[dtype](bandwidth_rule="scott")
    _ = kde.set_params(bandwidth=0.5, kernel="tophat").fit(x)
    assert_equal(kde.bandwidth_,0.5)
    assert_equal(kde.get_params().bandwidth_rule,"")
    assert_equal(kde.get_params().kernel,"tophat")
    _ = kde.set_params(bandwidth_rule="silverman").fit(x)
    # sklearn: (n * (d + 2) / 4) ** (-1 / (d + 4)) = 4.5 ** -0.2 (Python float pow).
    assert_true(abs(kde.bandwidth_ - 0.7402143449743067) <= 4.5e-16)
    var nc = NearestCentroid[dtype]()
    var priors = nm.zeros[DType.float64](nm.Shape(2))
    priors.unsafe_set(0,0.25)
    priors.unsafe_set(1,0.75)
    _ = nc.set_params(priors=priors.copy())
    assert_equal(nc.get_params().priors,"explicit")
    _ = nc.set_params(metric="manhattan", shrink_threshold=0.5)
    assert_equal(nc.get_params().metric,"manhattan")
    assert_equal(nc.get_params().shrink_threshold.value(),0.5)
    assert_equal(nc.get_params().priors,"explicit")
    _ = nc.set_params(priors="empirical")
    assert_equal(nc.get_params().priors,"empirical")
    assert_true(not nc.get_params().prior_probabilities)

def main() raises:
    exercise[DType.float32]()
    exercise[DType.float64]()
    edge_cases[DType.float32]()
    edge_cases[DType.float64]()
    keyword_params[DType.float32]()
    keyword_params[DType.float64]()
    print("PASS public nearest, KNN and radius estimators")
