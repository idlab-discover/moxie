"""PCA lifecycle, ownership, shapes, invalid settings and unavailable modes."""
from std.testing import assert_equal, assert_true, assert_false, assert_raises
from std.memory import bitcast
from numojo import NDArray, Shape, zeros, NDArrayStrides
from moxie.base import clone
from moxie.decomposition import PCA
from moxie.decomposition._pca_backend import PCABackend, RuntimePCABackend


def check[dtype: DType, Backend: PCABackend = RuntimePCABackend]() raises:
    var X = zeros[dtype](Shape(6, 3))
    for i in range(6):
        X.unsafe_set(i * 3, SIMD[dtype, 1](i))
        X.unsafe_set(i * 3 + 1, SIMD[dtype, 1](i * i))
        X.unsafe_set(i * 3 + 2, SIMD[dtype, 1](i % 2))
    var model = PCA[dtype, Backend](n_components=2)
    var all_components = PCA[dtype, Backend]()
    all_components.fit(X)
    assert_equal(all_components.n_components_, 3)
    with assert_raises(): _ = model.transform(X)
    var projected = model.fit_transform(X)
    assert_equal(projected.shape[1], 2)
    assert_equal(model.n_features_in_, 3)
    assert_equal(model.n_samples_, 6)
    assert_equal(X.unsafe_get(3), SIMD[dtype, 1](1))
    var names = model.get_feature_names_out()
    assert_equal(names[0], "pca0")
    assert_equal(names[1], "pca1")
    var params = model.get_params()
    params.whiten = True
    model.set_params(params)
    assert_true(model.whiten)
    model.set_params(whiten=False)
    var other = clone(model)
    assert_false(other.__sklearn_is_fitted__())
    assert_equal(other.svd_solver, "auto")
    var original_mean = model.mean_.value().unsafe_get(0)
    X.unsafe_set(0, 99)
    assert_equal(model.mean_.value().unsafe_get(0), original_mean)
    var reverse = X.view_with_layout(Shape(6, 3), NDArrayStrides(-3, 1), 15)
    model.fit(reverse)
    assert_true(model.__sklearn_is_fitted__())
    var wrong = zeros[dtype](Shape(2, 4))
    with assert_raises(): _ = model.transform(wrong)
    with assert_raises(): _ = model.inverse_transform(wrong)
    model.set_params(svd_solver="arpack")
    model.fit(X)
    assert_equal(model.n_components_, 2)
    var arpack_default = PCA[dtype, Backend](svd_solver="arpack")
    arpack_default.fit(X)
    assert_equal(arpack_default.n_components_, 2)
    var arpack_full = PCA[dtype, Backend](3, svd_solver="arpack")
    with assert_raises(): arpack_full.fit(X)
    var arpack_fraction = PCA[dtype, Backend](Float64(0.5), svd_solver="arpack")
    with assert_raises(): arpack_fraction.fit(X)
    model.set_params(svd_solver="bad")
    with assert_raises(): model.fit(X)
    model.set_params(svd_solver="full", n_oversamples=0)
    with assert_raises(): model.fit(X)
    var inplace = PCA[dtype, Backend](1, copy=False)
    with assert_raises(): inplace.fit(X)
    inplace.fit_inplace(X)
    var empty = zeros[dtype](Shape(0, 3))
    with assert_raises(): other.fit(empty)
    var nonfinite = X.copy()
    nonfinite.unsafe_set(0, SIMD[dtype, 1](bitcast[DType.float64](UInt64(0x7ff8000000000000))))
    with assert_raises(): other.fit(nonfinite)
    var zero = PCA[dtype, Backend](0)
    zero.fit(X)
    assert_equal(zero.transform(X).shape[1], 0)
    with assert_raises(): zero.set_output(transform="pandas")
    zero.set_output(transform="default")
    var fraction = PCA[dtype, Backend](Float64(0.9))
    fraction.fit(X)
    assert_true(fraction.n_components_ > 0)
    var mle = PCA[dtype, Backend](String("mle"))
    mle.fit(X)
    var bad_count = PCA[dtype, Backend](10)
    with assert_raises(): bad_count.fit(X)


def main() raises:
    check[DType.float32]()
    check[DType.float64]()
    print("PASS: dense PCA contracts in Float32 and Float64")
