import numojo as nm
from moxie.neighbors import NearestNeighbors, KNeighborsClassifier, KNeighborsRegressor, LocalOutlierFactor, KernelDensity

def main() raises:
    var x = nm.zeros[DType.float64](nm.Shape(4,1))
    x.unsafe_set(1,1)
    x.unsafe_set(2,2)
    x.unsafe_set(3,10)
    var y = nm.zeros[DType.float64](nm.Shape(4))
    y.unsafe_set(2,1)
    y.unsafe_set(3,1)
    var query = nm.full[DType.float64](nm.Shape(1,1),1.2)
    var neighbors = NearestNeighbors(2)
    neighbors.fit(x)
    var result = neighbors.kneighbors(query.view())
    print("Nearest training index:",result.indices[0])
    var classifier = KNeighborsClassifier(2,weights="distance")
    classifier.fit(x,y)
    var prediction = classifier.predict(query.view())
    print("Predicted class:",prediction.unsafe_get(0))
    var regression = KNeighborsRegressor(2,weights="distance")
    regression.fit(x,y)
    var value = regression.predict(query.view())
    print("Interpolated target:",value.unsafe_get(0))
    var lof = LocalOutlierFactor(2)
    var inlier = lof.fit_predict(x)
    print("Last training row inlier label:",inlier.unsafe_get(3))
    var kde = KernelDensity(bandwidth=0.5)
    kde.fit(x)
    print("Query log density:",kde.score(query))
