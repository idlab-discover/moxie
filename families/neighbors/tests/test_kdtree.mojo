import numojo as nm
from std.testing import assert_equal, assert_true, assert_raises
from moxie.neighbors import KDTree, NearestNeighbors, KernelDensity, LocalOutlierFactor
from moxie.base import clone
from moxie.neighbors._distance import Metric

def exercise[dtype: DType]() raises:
    var x = nm.zeros[dtype](nm.Shape(65,3))
    for i in range(65):
        for j in range(3): x.unsafe_set(i*3+j,Float64((i*13+j*7)%67).cast[dtype]())
    var tree = KDTree(x,2)
    for dual in [False,True]:
        for breadth in [False,True]:
            var result = tree.query(x,3,dualtree=dual,breadth_first=breadth)
            result.validate(65)
            for i in range(65):
                assert_equal(result.indices[i*3],i)
                assert_equal(result.distances.value().unsafe_get(i*3),0)
    var radius = tree.query_radius(x,0,True,sort_results=True)
    radius.neighbors.value().validate(65,True)
    assert_equal(len(radius.neighbors.value().indices),65)
    var counts = tree.query_radius(x,Float64("inf"),count_only=True)
    for count in counts.counts.value(): assert_equal(count,65)
    var radii = nm.zeros[DType.float64](nm.Shape(3))
    radii.unsafe_set(1,10)
    radii.unsafe_set(2,Float64("inf"))
    var corr = tree.two_point_correlation(x,radii)
    var corr2 = tree.two_point_correlation(x,radii,True)
    assert_equal(corr[0],65)
    assert_equal(corr[2],65*65)
    for i in range(3): assert_equal(corr[i],corr2[i])
    for kernel in ["gaussian","exponential","tophat","epanechnikov","linear","cosine"]:
        var density = tree.kernel_density(x,2,kernel)
        for i in range(65): assert_true(density.unsafe_get(i)>0)
    assert_true(tree.get_n_calls()>0)
    var stats = tree.get_tree_stats()
    assert_true(stats[0]>0 and stats[1]>0 and stats[2]>0)
    tree.reset_n_calls()
    assert_equal(tree.get_n_calls(),0)
    var arrays = tree.get_arrays()
    assert_equal(arrays.node_bounds.shape[0],2)
    arrays.data.unsafe_set(0,999)
    assert_equal(tree.data.unsafe_get(0),0)
    var estimator = NearestNeighbors[dtype](3,algorithm="kd_tree",leaf_size=2)
    estimator.fit(x)
    assert_equal(estimator._fit_method,"kd_tree")
    var neighbors = estimator.kneighbors()
    for i in range(65): assert_true(neighbors.indices[i*3]!=i)
    var self_radius = estimator.radius_neighbors(radius=Float64(0))
    assert_equal(len(self_radius.indices),0)
    with assert_raises(): _ = KDTree(x,metric="cosine")
    with assert_raises(): _ = KDTree(x,p=0.5)
    with assert_raises(): _ = KDTree(x,0)
    with assert_raises(): _ = tree.query(x,66)
    with assert_raises(): _ = tree.query_radius(x,1,True,True)
    # Counters accumulate; reset_n_calls does not reset traversal statistics.
    var counted = KDTree(x,2)
    _ = counted.query(x,3)
    var calls = counted.get_n_calls()
    var first_stats = counted.get_tree_stats()
    _ = counted.query(x,3)
    assert_equal(counted.get_n_calls(),2*calls)
    assert_equal(counted.get_tree_stats()[0],2*first_stats[0])
    assert_true(calls < 65*65)
    counted.reset_n_calls()
    assert_equal(counted.get_tree_stats()[1],2*first_stats[1])
    var indices_only = counted.query(x,2,False,sort_results=False)
    assert_true(not indices_only.distances)
    var empty = counted.query_radius(x,-1)
    assert_equal(len(empty.neighbors.value().indices),0)
    assert_true(not empty.neighbors.value().distances)
    with assert_raises(): _ = counted.query_radius(x,Float64("nan"))
    with assert_raises(): _ = counted.query_radius(x,1,sort_results=True)
    with assert_raises(): _ = counted.query(x,0)
    with assert_raises(): _ = counted.kernel_density(x,0)
    with assert_raises(): _ = counted.kernel_density(x,1,"unknown")
    with assert_raises(): _ = counted.kernel_density(x,1,atol=-1)
    var wrong = nm.zeros[dtype](nm.Shape(2,4))
    with assert_raises(): _ = counted.query(wrong)
    var invalid = nm.zeros[dtype](nm.Shape(0,3))
    with assert_raises(): _ = KDTree(invalid)
    var nan_data = x.copy()
    nan_data.unsafe_set(0,Float64("nan").cast[dtype]())
    with assert_raises(): _ = KDTree(nan_data)
    var zero_weights = nm.zeros[dtype](nm.Shape(65))
    var zero_tree = KDTree(x,sample_weight=zero_weights.view())
    var zero_density = zero_tree.kernel_density(x,1)
    for i in range(65): assert_equal(zero_density.unsafe_get(i),0)
    zero_weights.unsafe_set(0,-1)
    with assert_raises(): _ = KDTree(x,sample_weight=zero_weights.view())
    var weighted_metric = Metric[dtype]("minkowski",2,w=nm.ones[dtype](nm.Shape(3)))
    with assert_raises(): _ = KDTree(x,metric_params=weighted_metric.copy())
    for j in range(len(KDTree[dtype].valid_metrics)):
        var alias_tree = KDTree(x,metric=KDTree[dtype].valid_metrics[j])
        assert_equal(alias_tree.query(x).indices[0],0)
    # Strides, fitted snapshots, deep copy, and a repeated fit replacing the tree.
    var reversed_x = x.view_with_layout(nm.Shape(65,3),nm.NDArrayStrides(-3,1),64*3)
    var strided = KDTree(reversed_x,2)
    var reversed_result = strided.query(reversed_x)
    for i in range(65): assert_equal(reversed_result.indices[i],i)
    var copied = strided.copy()
    strided.data.unsafe_set(0,999)
    assert_true(copied.data.unsafe_get(0)!=999)
    var old = estimator.kneighbors(x.view(),1)
    with assert_raises(): estimator.fit(invalid)
    assert_equal(estimator.n_samples_fit_,65)
    var fresh = clone(estimator)
    with assert_raises(): _ = fresh.kneighbors()
    var changed = estimator.get_params()
    changed.algorithm = "brute"
    estimator.set_params(changed)
    assert_equal(estimator._fit_method,"kd_tree")
    estimator.fit(x)
    assert_equal(estimator._fit_method,"brute")
    var duplicates = nm.zeros[dtype](nm.Shape(9,3))
    var duplicate_tree = KDTree(duplicates,1)
    var tied = duplicate_tree.query(duplicates,9,dualtree=True)
    for i in range(9): assert_equal(tied.indices[i],i)
    var duplicate_neighbors = NearestNeighbors[dtype](8,algorithm="kd_tree",leaf_size=1)
    duplicate_neighbors.fit(duplicates)
    var excluded = duplicate_neighbors.kneighbors()
    for i in range(9):
        for j in range(8): assert_true(excluded.indices[i*8+j]!=i)
    var lof_tree = LocalOutlierFactor[dtype](3,algorithm="kd_tree",leaf_size=1,novelty=True)
    var lof_brute = LocalOutlierFactor[dtype](3,algorithm="brute",novelty=True)
    lof_tree.fit(x)
    lof_brute.fit(x)
    var tree_scores = lof_tree.score_samples(x)
    var brute_scores = lof_brute.score_samples(x)
    for i in range(65): assert_equal(tree_scores.unsafe_get(i),brute_scores.unsafe_get(i))
    print("PASS KDTree")

def main() raises:
    exercise[DType.float64]()
    exercise[DType.float32]()
