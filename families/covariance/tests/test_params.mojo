"""Keyword updates, nullable resets, configuration ownership and refit contracts."""
from moxie.covariance import MinCovDet, EllipticEnvelope, GraphicalLasso, GraphicalLassoCV
from moxie.covariance._graph_lasso_cv import AlphaGrid
from moxie.base import clone
from numojo import NDArray, Shape, zeros
from std.testing import assert_equal, assert_true, assert_false
from parity_io import emit, emit_scalar


def same[dtype: DType](a: NDArray[dtype], b: NDArray[dtype]) raises:
    assert_equal(a.ndim, b.ndim)
    for i in range(a.ndim):
        assert_equal(a.shape[i], b.shape[i])
    for i in range(a.size):
        assert_equal(a.unsafe_get(i), b.unsafe_get(i))


def data[dtype: DType](features: Int) raises -> NDArray[dtype]:
    var X = zeros[dtype](Shape(40, features))
    for i in range(40):
        for j in range(features):
            X.unsafe_set(i * features + j, (Float64((i * (j + 3)) % 17) / 7.0 + Float64(i % (j + 2))).cast[dtype]())
    return X^



def check_MinCovDet[dtype: DType]() raises:
    var X = data[dtype](2)
    var model = MinCovDet[dtype](random_state=7)
    model.fit(X)
    var before = model.covariance_()
    var location = model.location_()
    var precision = model.precision_().value().copy()
    var support = model.support_()
    var raw = model.raw_covariance_()
    var dist = model.dist_()
    var original = model.get_params()
    model.set_params()
    model.set_params(assume_centered=True)
    var partial = model.get_params(deep=False)
    assert_true(partial.assume_centered)
    assert_equal(partial.store_precision, original.store_precision)
    assert_equal(Bool(partial.support_fraction), Bool(original.support_fraction))
    if partial.support_fraction:
        assert_equal(partial.support_fraction.value(), original.support_fraction.value())
    assert_equal(Bool(partial.random_state), Bool(original.random_state))
    if partial.random_state:
        assert_equal(partial.random_state.value(), original.random_state.value())
    model.set_params(store_precision=False, assume_centered=True, support_fraction=0.8, random_state=13)
    var updated = model.get_params()
    assert_equal(updated.store_precision, False)
    assert_equal(updated.assume_centered, True)
    assert_equal(updated.support_fraction.value(), 0.8)
    assert_equal(updated.random_state.value(), 13)
    var roundtrip = MinCovDet[dtype]()
    roundtrip.set_params(updated)
    var copied = clone(model)
    assert_false(copied.__sklearn_is_fitted__())
    var round_params = roundtrip.get_params()
    var clone_params = copied.get_params()
    assert_equal(round_params.store_precision, updated.store_precision)
    assert_equal(round_params.assume_centered, updated.assume_centered)
    assert_equal(Bool(round_params.support_fraction), Bool(updated.support_fraction))
    if round_params.support_fraction:
        assert_equal(round_params.support_fraction.value(), updated.support_fraction.value())
    assert_equal(Bool(round_params.random_state), Bool(updated.random_state))
    if round_params.random_state:
        assert_equal(round_params.random_state.value(), updated.random_state.value())
    assert_equal(clone_params.store_precision, updated.store_precision)
    assert_equal(clone_params.assume_centered, updated.assume_centered)
    assert_equal(Bool(clone_params.support_fraction), Bool(updated.support_fraction))
    if clone_params.support_fraction:
        assert_equal(clone_params.support_fraction.value(), updated.support_fraction.value())
    assert_equal(Bool(clone_params.random_state), Bool(updated.random_state))
    if clone_params.random_state:
        assert_equal(clone_params.random_state.value(), updated.random_state.value())
    model.set_params(support_fraction=None, random_state=None)
    model.set_params()
    assert_false(Bool(model.support_fraction))
    assert_false(Bool(model.random_state))
    model.set_params(random_state=Optional[Int](7), support_fraction=Optional[Float64]())
    assert_equal(model.random_state.value(), 7)
    assert_false(Bool(model.support_fraction))
    assert_true(model.__sklearn_is_fitted__())
    same(before, model.covariance_())
    same(location, model.location_())
    same(precision, model.precision_().value())
    same(support, model.support_())
    same(raw, model.raw_covariance_())
    same(dist, model.dist_())
    model.set_params(original)
    same(before, model.covariance_())
    model.set_params(assume_centered=True, support_fraction=None, random_state=7)
    var Y = data[dtype](3)
    var expected = clone(model)
    expected.fit(Y)
    model.fit(Y)
    same(model.covariance_(), expected.covariance_())
    assert_equal(model.n_features_in_(), 3)
    var key = String("MinCovDet", "_", dtype)
    emit(String(key, "_covariance"), model.covariance_())
    emit(String(key, "_location"), model.location_())
    emit(String(key, "_support"), model.support_())
    model.set_params(support_fraction=2.0)
    assert_true(model.__sklearn_is_fitted__())
    var rejected = False
    try:
        model.fit(Y)
    except:
        rejected = True
    assert_true(rejected)


def check_EllipticEnvelope[dtype: DType]() raises:
    var X = data[dtype](2)
    var model = EllipticEnvelope[dtype](random_state=7)
    model.fit(X)
    var before = model.covariance_()
    var location = model.location_()
    var precision = model.precision_().value().copy()
    var support = model.support_()
    var raw = model.raw_covariance_()
    var dist = model.dist_()
    var offset = model.offset_()
    var original = model.get_params()
    model.set_params()
    model.set_params(assume_centered=True)
    var partial = model.get_params(deep=False)
    assert_true(partial.assume_centered)
    assert_equal(partial.store_precision, original.store_precision)
    assert_equal(Bool(partial.support_fraction), Bool(original.support_fraction))
    if partial.support_fraction:
        assert_equal(partial.support_fraction.value(), original.support_fraction.value())
    assert_equal(partial.contamination, original.contamination)
    assert_equal(Bool(partial.random_state), Bool(original.random_state))
    if partial.random_state:
        assert_equal(partial.random_state.value(), original.random_state.value())
    model.set_params(store_precision=False, assume_centered=True, support_fraction=0.8, contamination=0.2, random_state=13)
    var updated = model.get_params()
    assert_equal(updated.store_precision, False)
    assert_equal(updated.assume_centered, True)
    assert_equal(updated.support_fraction.value(), 0.8)
    assert_equal(updated.contamination, 0.2)
    assert_equal(updated.random_state.value(), 13)
    var roundtrip = EllipticEnvelope[dtype]()
    roundtrip.set_params(updated)
    var copied = clone(model)
    assert_false(copied.__sklearn_is_fitted__())
    var round_params = roundtrip.get_params()
    var clone_params = copied.get_params()
    assert_equal(round_params.store_precision, updated.store_precision)
    assert_equal(round_params.assume_centered, updated.assume_centered)
    assert_equal(Bool(round_params.support_fraction), Bool(updated.support_fraction))
    if round_params.support_fraction:
        assert_equal(round_params.support_fraction.value(), updated.support_fraction.value())
    assert_equal(round_params.contamination, updated.contamination)
    assert_equal(Bool(round_params.random_state), Bool(updated.random_state))
    if round_params.random_state:
        assert_equal(round_params.random_state.value(), updated.random_state.value())
    assert_equal(clone_params.store_precision, updated.store_precision)
    assert_equal(clone_params.assume_centered, updated.assume_centered)
    assert_equal(Bool(clone_params.support_fraction), Bool(updated.support_fraction))
    if clone_params.support_fraction:
        assert_equal(clone_params.support_fraction.value(), updated.support_fraction.value())
    assert_equal(clone_params.contamination, updated.contamination)
    assert_equal(Bool(clone_params.random_state), Bool(updated.random_state))
    if clone_params.random_state:
        assert_equal(clone_params.random_state.value(), updated.random_state.value())
    model.set_params(support_fraction=None, random_state=None)
    model.set_params()
    assert_false(Bool(model.support_fraction))
    assert_false(Bool(model.random_state))
    model.set_params(random_state=Optional[Int](7), support_fraction=Optional[Float64]())
    assert_equal(model.random_state.value(), 7)
    assert_false(Bool(model.support_fraction))
    assert_true(model.__sklearn_is_fitted__())
    same(before, model.covariance_())
    same(location, model.location_())
    same(precision, model.precision_().value())
    same(support, model.support_())
    same(raw, model.raw_covariance_())
    same(dist, model.dist_())
    assert_equal(offset, model.offset_())
    model.set_params(original)
    same(before, model.covariance_())
    model.set_params(assume_centered=True, support_fraction=None, random_state=7, contamination=0.2)
    var Y = data[dtype](3)
    var expected = clone(model)
    expected.fit(Y)
    model.fit(Y)
    same(model.covariance_(), expected.covariance_())
    assert_equal(model.n_features_in_(), 3)
    var key = String("EllipticEnvelope", "_", dtype)
    emit(String(key, "_covariance"), model.covariance_())
    emit(String(key, "_location"), model.location_())
    emit(String(key, "_support"), model.support_())
    emit_scalar(String(key, "_offset"), model.offset_())
    model.set_params(support_fraction=2.0)
    assert_true(model.__sklearn_is_fitted__())
    var rejected = False
    try:
        model.fit(Y)
    except:
        rejected = True
    assert_true(rejected)


def check_GraphicalLasso[dtype: DType]() raises:
    var X = data[dtype](2)
    var model = GraphicalLasso[dtype]()
    model.fit(X)
    var before = model.covariance_()
    var location = model.location_()
    var precision = model.precision_().value().copy()
    var original = model.get_params()
    model.set_params()
    model.set_params(assume_centered=True)
    var partial = model.get_params(deep=False)
    assert_true(partial.assume_centered)
    assert_equal(partial.alpha, original.alpha)
    assert_equal(partial.mode, original.mode)
    assert_equal(Bool(partial.covariance), Bool(original.covariance))
    if partial.covariance:
        assert_equal(partial.covariance.value(), original.covariance.value())
    assert_equal(partial.tol, original.tol)
    assert_equal(partial.enet_tol, original.enet_tol)
    assert_equal(partial.max_iter, original.max_iter)
    assert_equal(partial.verbose, original.verbose)
    assert_equal(partial.eps, original.eps)
    model.set_params(alpha=0.2, mode="cd", covariance="precomputed", tol=2e-4, enet_tol=3e-4, max_iter=120, verbose=True, eps=1e-12, assume_centered=True)
    var updated = model.get_params()
    assert_equal(updated.alpha, 0.2)
    assert_equal(updated.mode, "cd")
    assert_equal(updated.covariance.value(), String("precomputed"))
    assert_equal(updated.tol, 2e-4)
    assert_equal(updated.enet_tol, 3e-4)
    assert_equal(updated.max_iter, 120)
    assert_equal(updated.verbose, True)
    assert_equal(updated.eps, 1e-12)
    assert_equal(updated.assume_centered, True)
    var roundtrip = GraphicalLasso[dtype]()
    roundtrip.set_params(updated)
    var copied = clone(model)
    assert_false(copied.__sklearn_is_fitted__())
    var round_params = roundtrip.get_params()
    var clone_params = copied.get_params()
    assert_equal(round_params.alpha, updated.alpha)
    assert_equal(round_params.mode, updated.mode)
    assert_equal(Bool(round_params.covariance), Bool(updated.covariance))
    if round_params.covariance:
        assert_equal(round_params.covariance.value(), updated.covariance.value())
    assert_equal(round_params.tol, updated.tol)
    assert_equal(round_params.enet_tol, updated.enet_tol)
    assert_equal(round_params.max_iter, updated.max_iter)
    assert_equal(round_params.verbose, updated.verbose)
    assert_equal(round_params.eps, updated.eps)
    assert_equal(round_params.assume_centered, updated.assume_centered)
    assert_equal(clone_params.alpha, updated.alpha)
    assert_equal(clone_params.mode, updated.mode)
    assert_equal(Bool(clone_params.covariance), Bool(updated.covariance))
    if clone_params.covariance:
        assert_equal(clone_params.covariance.value(), updated.covariance.value())
    assert_equal(clone_params.tol, updated.tol)
    assert_equal(clone_params.enet_tol, updated.enet_tol)
    assert_equal(clone_params.max_iter, updated.max_iter)
    assert_equal(clone_params.verbose, updated.verbose)
    assert_equal(clone_params.eps, updated.eps)
    assert_equal(clone_params.assume_centered, updated.assume_centered)
    model.set_params(covariance=None)
    model.set_params()
    assert_false(Bool(model.covariance))
    assert_true(model.__sklearn_is_fitted__())
    same(before, model.covariance_())
    same(location, model.location_())
    same(precision, model.precision_().value())
    model.set_params(original)
    same(before, model.covariance_())
    model.set_params(assume_centered=True, verbose=False)
    var Y = data[dtype](3)
    var expected = clone(model)
    expected.fit(Y)
    model.fit(Y)
    same(model.covariance_(), expected.covariance_())
    assert_equal(model.n_features_in_(), 3)
    var key = String("GraphicalLasso", "_", dtype)
    emit(String(key, "_covariance"), model.covariance_())
    emit(String(key, "_location"), model.location_())
    model.set_params(tol=-1.0)
    assert_true(model.__sklearn_is_fitted__())
    var rejected = False
    try:
        model.fit(Y)
    except:
        rejected = True
    assert_true(rejected)


def check_GraphicalLassoCV[dtype: DType]() raises:
    var X = data[dtype](2)
    var model = GraphicalLassoCV[dtype]()
    model.fit(X)
    var before = model.covariance_()
    var location = model.location_()
    var precision = model.precision_().value().copy()
    var results = model.cv_results_()
    var alpha = model.alpha_()
    var original = model.get_params()
    model.set_params()
    model.set_params(assume_centered=True)
    var partial = model.get_params(deep=False)
    assert_true(partial.assume_centered)
    assert_equal(partial.alphas.count, original.alphas.count)
    assert_equal(Bool(partial.alphas.values), Bool(original.alphas.values))
    if partial.alphas.values:
        for i in range(partial.alphas.count):
            assert_equal(partial.alphas.values.value()[i], original.alphas.values.value()[i])
    assert_equal(partial.n_refinements, original.n_refinements)
    assert_equal(Bool(partial.cv), Bool(original.cv))
    if partial.cv:
        assert_equal(partial.cv.value(), original.cv.value())
    assert_equal(partial.tol, original.tol)
    assert_equal(partial.enet_tol, original.enet_tol)
    assert_equal(partial.max_iter, original.max_iter)
    assert_equal(partial.mode, original.mode)
    assert_equal(Bool(partial.n_jobs), Bool(original.n_jobs))
    if partial.n_jobs:
        assert_equal(partial.n_jobs.value(), original.n_jobs.value())
    assert_equal(partial.verbose, original.verbose)
    assert_equal(partial.eps, original.eps)
    var grid: List[Float64] = [0.3, 0.1]
    model.set_params(alphas=grid, n_refinements=2, cv=3, tol=2e-4, enet_tol=3e-4, max_iter=120, mode="cd", n_jobs=1, verbose=True, eps=1e-12, assume_centered=True)
    var updated = model.get_params()
    assert_equal(updated.alphas.values.value()[0], 0.3)
    assert_equal(updated.n_refinements, 2)
    assert_equal(updated.cv.value(), 3)
    assert_equal(updated.tol, 2e-4)
    assert_equal(updated.enet_tol, 3e-4)
    assert_equal(updated.max_iter, 120)
    assert_equal(updated.mode, "cd")
    assert_equal(updated.n_jobs.value(), 1)
    assert_equal(updated.verbose, True)
    assert_equal(updated.eps, 1e-12)
    assert_equal(updated.assume_centered, True)
    var roundtrip = GraphicalLassoCV[dtype]()
    roundtrip.set_params(updated)
    var copied = clone(model)
    assert_false(copied.__sklearn_is_fitted__())
    var round_params = roundtrip.get_params()
    var clone_params = copied.get_params()
    assert_equal(round_params.alphas.count, updated.alphas.count)
    assert_equal(Bool(round_params.alphas.values), Bool(updated.alphas.values))
    if round_params.alphas.values:
        for i in range(round_params.alphas.count):
            assert_equal(round_params.alphas.values.value()[i], updated.alphas.values.value()[i])
    assert_equal(round_params.n_refinements, updated.n_refinements)
    assert_equal(Bool(round_params.cv), Bool(updated.cv))
    if round_params.cv:
        assert_equal(round_params.cv.value(), updated.cv.value())
    assert_equal(round_params.tol, updated.tol)
    assert_equal(round_params.enet_tol, updated.enet_tol)
    assert_equal(round_params.max_iter, updated.max_iter)
    assert_equal(round_params.mode, updated.mode)
    assert_equal(Bool(round_params.n_jobs), Bool(updated.n_jobs))
    if round_params.n_jobs:
        assert_equal(round_params.n_jobs.value(), updated.n_jobs.value())
    assert_equal(round_params.verbose, updated.verbose)
    assert_equal(round_params.eps, updated.eps)
    assert_equal(round_params.assume_centered, updated.assume_centered)
    assert_equal(clone_params.alphas.count, updated.alphas.count)
    assert_equal(Bool(clone_params.alphas.values), Bool(updated.alphas.values))
    if clone_params.alphas.values:
        for i in range(clone_params.alphas.count):
            assert_equal(clone_params.alphas.values.value()[i], updated.alphas.values.value()[i])
    assert_equal(clone_params.n_refinements, updated.n_refinements)
    assert_equal(Bool(clone_params.cv), Bool(updated.cv))
    if clone_params.cv:
        assert_equal(clone_params.cv.value(), updated.cv.value())
    assert_equal(clone_params.tol, updated.tol)
    assert_equal(clone_params.enet_tol, updated.enet_tol)
    assert_equal(clone_params.max_iter, updated.max_iter)
    assert_equal(clone_params.mode, updated.mode)
    assert_equal(Bool(clone_params.n_jobs), Bool(updated.n_jobs))
    if clone_params.n_jobs:
        assert_equal(clone_params.n_jobs.value(), updated.n_jobs.value())
    assert_equal(clone_params.verbose, updated.verbose)
    assert_equal(clone_params.eps, updated.eps)
    assert_equal(clone_params.assume_centered, updated.assume_centered)
    updated.alphas.values.value()[0] = 99.0
    assert_equal(model.alphas.values.value()[0], 0.3)
    assert_equal(copied.alphas.values.value()[0], 0.3)
    assert_equal(roundtrip.alphas.values.value()[0], 0.3)
    model.set_params(cv=None, n_jobs=None)
    model.set_params()
    assert_false(Bool(model.cv))
    assert_false(Bool(model.n_jobs))
    model.set_params(cv=Optional[Int](3), n_jobs=Optional[Int]())
    assert_equal(model.cv.value(), 3)
    assert_false(Bool(model.n_jobs))
    model.set_params(alphas=3)
    assert_false(Bool(model.alphas.values))
    model.set_params(alphas=AlphaGrid(grid))
    assert_true(model.__sklearn_is_fitted__())
    same(before, model.covariance_())
    same(location, model.location_())
    same(precision, model.precision_().value())
    same(results.mean_test_score, model.cv_results_().mean_test_score)
    assert_equal(alpha, model.alpha_())
    model.set_params(original)
    same(before, model.covariance_())
    model.set_params(assume_centered=True, verbose=False)
    var Y = data[dtype](3)
    var expected = clone(model)
    expected.fit(Y)
    model.fit(Y)
    same(model.covariance_(), expected.covariance_())
    assert_equal(model.n_features_in_(), 3)
    var key = String("GraphicalLassoCV", "_", dtype)
    emit(String(key, "_covariance"), model.covariance_())
    emit(String(key, "_location"), model.location_())
    emit_scalar(String(key, "_alpha"), model.alpha_())
    model.set_params(tol=-1.0)
    assert_true(model.__sklearn_is_fitted__())
    var rejected = False
    try:
        model.fit(Y)
    except:
        rejected = True
    assert_true(rejected)


def main() raises:
    check_MinCovDet[DType.float64]()
    check_MinCovDet[DType.float32]()
    check_EllipticEnvelope[DType.float64]()
    check_EllipticEnvelope[DType.float32]()
    check_GraphicalLasso[DType.float64]()
    check_GraphicalLasso[DType.float32]()
    check_GraphicalLassoCV[DType.float64]()
    check_GraphicalLassoCV[DType.float32]()
